<?xml version="1.0" encoding="utf-8"?>
<!-- The Android TV banner (android:banner): the app's own notification
     glyph (ic_notification's cloud with download arrow, the same mark
     shown in the persistent foreground-service notification) enlarged
     and recolored to the sage brand accent (ks_sage, #749C6F) on the
     app's dark surface (ks_dark_bg, #202124), since DroidMesh is an
     internal fleet-admin updater with no separate wordmark lockup to
     restack the way Kiosk Satellite's banner does. Declared at 320x180dp
     with a matching 320x180 viewport, twice the platform's nominal
     160x90 banner size, because the stock TV home rasterizes this
     drawable once at its intrinsic size and scales that bitmap to its
     card; at 1x the glyph came out soft on a Shield, so 2x is used
     instead, matching the resolution kiosk-satellite's own banner
     settled on for the same reason (gitea#81).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">
    <path
        android:fillColor="#FF202124"
        android:pathData="M0 0h320v180H0z"/>
    <!-- ic_notification's path, viewBox 24x24, scaled 4x (96x96dp) and
         centered in the 320x180 field. -->
    <group
        android:scaleX="4"
        android:scaleY="4"
        android:translateX="112"
        android:translateY="42">
        <path
            android:fillColor="#FF749C6F"
            android:pathData="M19.35,10.04C18.67,6.59 15.64,4 12,4 9.11,4 6.6,5.64 5.35,8.04 2.34,8.36 0,10.91 0,14c0,3.31 2.69,6 6,6h13c2.76,0 5,-2.24 5,-5 0,-2.64 -2.05,-4.78 -4.65,-4.96zM17,13l-5,5 -5,-5h3V9h4v4h3z"/>
    </group>
</vector>
