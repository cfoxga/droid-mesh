<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ks_surface_container"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_disc_teal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_tab_mesh"
            app:tint="@color/white" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/rubik"
        android:text="Connect Cross-VLAN Mesh"
        android:textColor="@color/ks_on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/rubik"
        android:gravity="center"
        android:text="Enter the IP address of any device on another VLAN. The meshes will exchange info and automatically stay connected across reboots."
        android:textColor="@color/ks_on_surface_variant"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etSeedIpInput"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dropdown_box"
        android:fontFamily="@font/rubik"
        android:hint="192.168.50.64"
        android:inputType="textUri"
        android:paddingHorizontal="14dp"
        android:textColor="@color/ks_on_surface"
        android:textColorHint="@color/ks_outline"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelConnect"
            style="@style/Widget.KS.Button.Pill.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitConnect"
            style="@style/Widget.KS.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Connect &amp; Discover" />
    </LinearLayout>
</LinearLayout>
