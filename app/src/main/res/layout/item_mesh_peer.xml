<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.KS.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Top Header Row: Device Title, Self/VLAN Badges, State Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPeerDeviceIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_tab_overview"
                app:tint="@color/ks_teal" />

            <TextView
                android:id="@+id/tvPeerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/rubik"
                android:maxLines="1"
                android:textColor="@color/ks_on_surface"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Facebook PortalMini" />

            <TextView
                android:id="@+id/tvPeerSelfBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/ks_teal_container"
                android:fontFamily="@font/rubik"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="This Device"
                android:textColor="@color/ks_teal"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvPeerVlanBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/ks_surface_highest"
                android:fontFamily="@font/rubik"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="VLAN"
                android:textColor="@color/ks_on_surface_variant"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvPeerStateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/ks_sage_container"
                android:fontFamily="@font/rubik"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="ONLINE"
                android:textColor="@color/ks_sage"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/ks_outline_variant" />

        <!-- Key-Value Rows Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: IP Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/rubik"
                    android:text="IP Address"
                    android:textColor="@color/ks_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvPeerIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/rubik"
                    android:textColor="@color/ks_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="192.168.40.250" />
            </LinearLayout>

            <!-- Row 2: Network ADB -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingVertical="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/rubik"
                    android:text="Network ADB"
                    android:textColor="@color/ks_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvPeerAdbStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/rubik"
                    android:textColor="@color/ks_sage"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Enabled (:5555)" />
            </LinearLayout>

            <!-- Row 3: Installed Apps Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layoutPeerAppsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/tvPeerAppsLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/rubik"
                        android:text="INSTALLED APPS"
                        android:textColor="@color/ks_outline"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPeerAppsCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/ks_teal_container"
                        android:fontFamily="@font/rubik"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="0 Managed"
                        android:textColor="@color/ks_teal"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPeerAppsActionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/ks_rust_container"
                        android:fontFamily="@font/rubik"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="Update Needed"
                        android:textColor="@color/ks_rust"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvPeerAppsChevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/rubik"
                        android:text="▼"
                        android:textColor="@color/ks_outline"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPeerApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_dropdown_box"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
