<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.KS.NestedCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Device title and status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPeerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/rubik"
                android:textColor="@color/ks_on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Portal 10 (192.168.40.250) [This Device]" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPeerAdbStatus"
                style="@style/Widget.KS.Button.Pill.Small"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="10dp"
                android:backgroundTint="@color/ks_surface_container"
                android:textColor="@color/ks_on_surface"
                app:strokeColor="@color/ks_outline"
                app:strokeWidth="1dp"
                android:text="ADB: ON" />

            <TextView
                android:id="@+id/tvPeerStateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:fontFamily="@font/rubik"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="IDLE"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Middle: Installed version & target match status -->
        <TextView
            android:id="@+id/tvPeerVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/rubik"
            android:textColor="@color/ks_on_surface_variant"
            android:textSize="14sp"
            tools:text="Installed Satellite: v2026.8.105 (build 105)" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/ks_outline_variant" />

        <!-- Bottom: Status message / Last seen and conditional Update button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPeerMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/rubik"
                    android:maxLines="1"
                    android:textColor="@color/ks_on_surface_variant"
                    android:textSize="12sp"
                    tools:text="Status: Listening on port 2325" />

                <TextView
                    android:id="@+id/tvPeerLastSeen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/rubik"
                    android:textColor="@color/ks_outline"
                    android:textSize="11sp"
                    tools:text="Last seen: Just now" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPeerUpdate"
                style="@style/Widget.KS.Button.Pill.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Update"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
