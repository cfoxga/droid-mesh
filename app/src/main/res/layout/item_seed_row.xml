<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_dropdown_box"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvSeedIp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textColor="@color/ks_on_surface"
        android:textSize="13sp"
        tools:text="192.168.50.64:2325" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoveSeed"
        style="@style/Widget.KS.Button.Pill.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="Remove"
        android:textColor="@color/ks_rust" />
</LinearLayout>
