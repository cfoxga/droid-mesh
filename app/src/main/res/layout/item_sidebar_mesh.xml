<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/btnSidebarMesh"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_rail_item_selected"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <FrameLayout
        android:id="@+id/layoutMeshDisc"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_disc_teal">

        <ImageView
            android:id="@+id/ivMeshIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_tab_mesh"
            app:tint="@color/white" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvMeshTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/rubik"
        android:maxLines="1"
        android:textColor="@color/ks_on_surface"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Meta Portals" />

    <TextView
        android:id="@+id/tvMeshNodeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_badge_pill"
        android:backgroundTint="@color/ks_sage_container"
        android:fontFamily="@font/rubik"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/ks_sage"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="2" />
</LinearLayout>
