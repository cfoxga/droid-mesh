<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DroidMesh" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ks_sage</item>
        <item name="colorPrimaryVariant">@color/ks_sage_container</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ks_teal</item>
        <item name="colorSecondaryVariant">@color/ks_teal_container</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorError">@color/ks_rust</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorSurface">@color/ks_surface_container</item>
        <item name="colorOnSurface">@color/ks_on_surface</item>
        <item name="android:statusBarColor">@color/ks_dark_bg</item>
        <item name="android:navigationBarColor">@color/ks_dark_bg</item>
        <item name="android:windowBackground">@color/ks_dark_bg</item>
        <item name="fontFamily">@font/rubik</item>
        <item name="android:fontFamily">@font/rubik</item>
    </style>

    <style name="Widget.KS.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/ks_surface_container</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/ks_outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.KS.NestedCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/ks_surface_high</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/ks_outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.KS.Button.Pill" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">100dp</item>
        <item name="backgroundTint">@color/ks_sage</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="fontFamily">@font/rubik</item>
        <item name="android:fontFamily">@font/rubik</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.KS.Button.Pill.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">100dp</item>
        <item name="strokeColor">@color/ks_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/ks_on_surface</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="fontFamily">@font/rubik</item>
        <item name="android:fontFamily">@font/rubik</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.KS.Button.Pill.Small" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">100dp</item>
        <item name="backgroundTint">@color/ks_sage</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="fontFamily">@font/rubik</item>
        <item name="android:fontFamily">@font/rubik</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
